#!/usr/bin/env python3
"""usage-monitor — pull Anthropic API token spend for the last N days.

Requires an ADMIN API key (starts with sk-ant-admin01-…) in
ANTHROPIC_ADMIN_KEY. A workspace/regular key won't work — the usage
report endpoints are admin-scoped. Get one from:
https://console.anthropic.com/settings/admin-keys

Usage:
    usage-monitor                 # last 7 days summary
    usage-monitor --days 30       # last 30 days
    usage-monitor --json          # machine-readable
    usage-monitor --breakdown     # per-model breakdown
    usage-monitor --check         # just verify the key works

Docs: https://docs.anthropic.com/en/api/admin-api/usage-cost/get-messages-usage-report
"""
from __future__ import annotations
import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone

API_BASE = "https://api.anthropic.com"
ADMIN_KEY_ENV = "ANTHROPIC_ADMIN_KEY"


def _fetch(path: str, params: dict) -> dict:
    key = os.environ.get(ADMIN_KEY_ENV)
    if not key:
        sys.stderr.write(
            f"usage-monitor: {ADMIN_KEY_ENV} not set.\n"
            f"Get an admin key: https://console.anthropic.com/settings/admin-keys\n"
        )
        sys.exit(3)
    qs = "&".join(f"{k}={v}" for k, v in params.items())
    url = f"{API_BASE}{path}?{qs}"
    req = urllib.request.Request(url, headers={
        "x-api-key": key,
        "anthropic-version": "2023-06-01",
    })
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        sys.stderr.write(f"usage-monitor: HTTP {e.code} — {body}\n")
        sys.exit(2)
    except urllib.error.URLError as e:
        sys.stderr.write(f"usage-monitor: network error — {e.reason}\n")
        sys.exit(2)


def _fmt_num(n: int) -> str:
    if n >= 1_000_000:
        return f"{n/1_000_000:.2f}M"
    if n >= 1_000:
        return f"{n/1_000:.1f}k"
    return str(n)


def _summarize(data: dict) -> dict:
    """Roll up the daily usage report into a total."""
    totals = {"uncached_input": 0, "cache_read": 0, "cache_creation": 0,
              "output": 0, "server_tool_use": 0}
    per_model: dict[str, dict[str, int]] = {}
    for bucket in data.get("data", []):
        for result in bucket.get("results", []):
            model = result.get("model", "unknown")
            pm = per_model.setdefault(model, dict(totals))
            for k in totals:
                v = int(result.get(f"{k}_tokens", 0) or 0)
                totals[k] += v
                pm[k] += v
    return {"totals": totals, "per_model": per_model}


def _cmd(argv=None) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--days", type=int, default=7)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--breakdown", action="store_true")
    ap.add_argument("--check", action="store_true",
                    help="verify admin key works; exit 0 if yes")
    args = ap.parse_args(argv)

    now = datetime.now(timezone.utc)
    starting_at = (now - timedelta(days=args.days)).strftime("%Y-%m-%dT00:00:00Z")

    if args.check:
        data = _fetch("/v1/organizations/usage_report/messages",
                      {"starting_at": starting_at, "limit": 1})
        print("ok — admin key valid; " +
              f"buckets returned: {len(data.get('data', []))}")
        return 0

    data = _fetch("/v1/organizations/usage_report/messages",
                  {"starting_at": starting_at, "limit": 31})
    summary = _summarize(data)

    if args.json:
        print(json.dumps(summary, indent=2))
        return 0

    t = summary["totals"]
    total_in = t["uncached_input"] + t["cache_read"] + t["cache_creation"]
    print(f"Anthropic API usage — last {args.days}d")
    print(f"  input tokens (uncached):   {_fmt_num(t['uncached_input'])}")
    print(f"  input tokens (cache-read): {_fmt_num(t['cache_read'])}  "
          f"[10% price]")
    print(f"  cache-creation tokens:     {_fmt_num(t['cache_creation'])}  "
          f"[125% price]")
    print(f"  output tokens:             {_fmt_num(t['output'])}")
    if total_in:
        cache_hit = 100 * t["cache_read"] / total_in
        print(f"  cache hit rate:            {cache_hit:.1f}%   "
              f"(higher = cheaper)")

    if args.breakdown:
        print()
        print("Per model:")
        for model, pm in sorted(summary["per_model"].items()):
            model_total = sum(pm.values())
            print(f"  {model}: total={_fmt_num(model_total)} "
                  f"out={_fmt_num(pm['output'])}")

    return 0


if __name__ == "__main__":
    raise SystemExit(_cmd())
